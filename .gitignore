# Local working directory: sample inputs, scratch scripts, generated output.
# Not part of the toolkit; never commit.
local/

# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Local documents and generated reports — keep sample/test files
# and tool output out of version control
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls
*.pdf
*_inspect.txt
inspect_*.txt
*_probe.txt
probe_*.txt
*_media/

# Archives and data bundles -- keep local working data out of version control
*.zip
*.tar
*.tar.gz
*.tgz

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.tmp
~$*

# Generated by builder/tests/extract_app_script.py
builder/tests/app_script.js

# Task tracker. Task bodies name real modules and part numbers; this is a public repo.
backlog/

# Migration snapshots (pre-image copies of report data). Never commit.
_migrations/

# Local dev tooling for the v2 browser smoke test
node_modules/
package-lock.json
